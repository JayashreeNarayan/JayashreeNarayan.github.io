<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ site.first_name }} {{ site.last_name }}</title>
    <meta name="description" content="{{ page.subtitle | strip_html | strip }}">
    <link rel="icon" href="{{ site.icon | prepend: '/assets/img/' | relative_url }}">
    <link rel="apple-touch-icon" href="{{ '/assets/img/apple-touch-icon.png' | relative_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <style>
      :root {
        /* Palette: coolors.co/0b1018-1c161a-3f92e0-205fa4-6b4141 */
        --bg: #ffffff;        /* white */
        --fg: #023047;        /* navy: body text, name, links */
        --heading: #023047;
        --accent: #023047;    /* link text */
        --underline: #fb8500; /* orange: link underline */
        --hover: #fb8500;     /* orange: link hover */
        --muted: #219ebc;     /* teal: dates, section labels */
        --meta: #023047;      /* author lists */
        --rule: #8ecae6;      /* light blue: footer line */
        --highlight: #ffb703; /* yellow: line under the header */
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 4.5rem; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: "Inter", system-ui, sans-serif;
        font-size: 16px;
        line-height: 1.6;
      }
      a { color: var(--accent); text-decoration: underline; text-decoration-color: var(--underline); text-underline-offset: 3px; text-decoration-thickness: 2px; }
      a:hover { color: var(--hover); }
      .wrap { max-width: 720px; margin: 0 auto; padding: 0 1rem; }

      header {
        position: sticky; top: 0; z-index: 10;
        background: var(--bg);
        border-bottom: 2px solid var(--highlight);
      }
      header .wrap { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; padding-top: 1rem; padding-bottom: 1rem; }
      header .name { font-weight: 600; text-decoration: none; color: var(--heading); }
      header nav a { text-decoration: none; margin-left: 1.25rem; color: var(--fg); }
      header nav a:hover { color: var(--accent); }
      header nav a:first-child { margin-left: 0; }
      header nav a:hover { text-decoration: underline; }

      section { padding: 3rem 0 1rem; }
      h2 { color: var(--muted); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 1.25rem; }

      .about { display: flex; gap: 2rem; align-items: flex-start; }
      .about .text p:first-child { margin-top: 0; }
      .about img { width: 160px; height: 160px; border-radius: 4px; object-fit: cover; flex-shrink: 0; }
      .subtitle { color: var(--fg); margin: 0 0 1rem; }

      ul.rows { list-style: none; margin: 0; padding: 0; }
      ul.rows li { display: flex; gap: 1.5rem; padding: 0.35rem 0; }
      ul.rows .when { color: var(--muted); font-weight: 600; flex: 0 0 7rem; font-variant-numeric: tabular-nums; }
      ul.rows .what p { margin: 0; display: inline; }

      ol.bibliography { list-style: none; margin: 0; padding: 0; }
      ol.bibliography li { margin-bottom: 1.25rem; }
      .pub .meta { color: var(--meta); }
      .pub .title a { color: var(--fg); }
      h2.bibliography { display: none; }

      footer { border-top: 1px solid var(--rule); margin-top: 3rem; padding: 1.5rem 0 2.5rem; color: var(--fg); font-size: 0.9rem; }
      footer .links a { margin-right: 1rem; }

      @media (max-width: 560px) {
        .about { flex-direction: column-reverse; }
        ul.rows li { flex-direction: column; gap: 0; }
        ul.rows .when { flex-basis: auto; }
        header nav a { margin-left: 0.9rem; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap">
        <a class="name" href="#about">{{ site.first_name }} {{ site.last_name }}</a>
        <nav>
          <a href="#about">About</a>
          <a href="#news">News</a>
          <a href="#publications">Publications</a>
          <a href="#cv">CV</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <section id="about">
        <p class="subtitle">{{ page.subtitle }}</p>
        <div class="about">
          <div class="text">{{ content }}</div>
          {% if page.profile.image %}
            <img src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}" alt="{{ site.first_name }} {{ site.last_name }}">
          {% endif %}
        </div>
      </section>

      <section id="news">
        <h2>News</h2>
        <ul class="rows">
          {% assign news = site.news | reverse %}
          {% for item in news %}
            <li>
              <span class="when">{{ item.date | date: '%b %Y' }}</span>
              <span class="what">{{ item.content | remove: '<p>' | remove: '</p>' | strip }}</span>
            </li>
          {% endfor %}
        </ul>
      </section>

      <section id="publications">
        <h2>Publications</h2>
        {% bibliography %}
      </section>

      <section id="cv">
        <h2>CV</h2>
        <ul class="rows">
          {% for row in site.data.timeline %}
            <li>
              <span class="when">{{ row.year }}</span>
              <span class="what">{{ row.text | markdownify | remove: '<p>' | remove: '</p>' | strip }}</span>
            </li>
          {% endfor %}
        </ul>
      </section>
    </main>

    <footer>
      <div class="wrap">
        <p class="links">
          {% assign s = site.data.socials %}
          {% if s.email %}<a href="mailto:{{ s.email | encode_email }}">Email</a>{% endif %}
          {% if s.scholar_userid %}<a href="https://scholar.google.com/citations?user={{ s.scholar_userid }}">Google Scholar</a>{% endif %}
          {% if s.github_username %}<a href="https://github.com/{{ s.github_username }}">GitHub</a>{% endif %}
          {% if s.linkedin_username %}<a href="https://www.linkedin.com/in/{{ s.linkedin_username }}">LinkedIn</a>{% endif %}
          {% if s.bluesky_url %}<a href="{{ s.bluesky_url }}">Bluesky</a>{% endif %}
          {% if s.x_username %}<a href="https://x.com/{{ s.x_username }}">X</a>{% endif %}
        </p>
      </div>
    </footer>
    <script>
      // Open links to other websites in a new tab
      document.querySelectorAll('a[href^="http"]').forEach(function (a) {
        a.target = "_blank";
        a.rel = "noopener noreferrer";
      });
    </script>
  </body>
</html>
