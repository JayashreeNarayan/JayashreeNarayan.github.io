---
---
{%- capture authors -%}
  {%- for author in entry.author_array -%}
    {%- assign name = author.first | append: ' ' | append: author.last -%}
    {%- if site.scholar.last_name contains author.last and site.scholar.first_name contains author.first -%}
      <strong>{{ name }}</strong>
    {%- else -%}
      {{ name }}
    {%- endif -%}
    {%- unless forloop.last -%}, {% endunless -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign doi = entry.doi | remove: 'https://doi.org/' -%}
<div class="pub">
  <div class="title">
    {%- if doi -%}<a href="https://doi.org/{{ doi }}">{{ entry.title }}</a>{%- else -%}{{ entry.title }}{%- endif -%}
  </div>
  <div class="meta">{{ authors }} · <em>{{ entry.journal }}</em>, {{ entry.year }}</div>
</div>
